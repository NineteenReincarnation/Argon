{
    "schemaVersion": 1,
    "id": "argon",
    "version": "${version}",
    "name": "Argon",
    "description": "A modular, compatibility-first performance optimization mod for Minecraft.",
    "authors": [
        "NineteenReincarnation"
    ],
    "contact": {
        "sources": "https://github.com/NineteenReincarnation/Argon",
        "issues": "https://github.com/NineteenReincarnation/Argon/issues"
    },
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.nineteenreincarnation.argon.Argon"
        ],
        "client": [
            "io.github.nineteenreincarnation.argon.client.ArgonClient"
        ]
    },
    "mixins": [
        {
            "config": "argon.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.2",
        "java": ">=25"
    }
}
